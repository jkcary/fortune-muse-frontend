{
  "expo": {
    "name": "ORACLE ONE",
    "slug": "fortune-muse",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/oracle-one-icon.png",
    "scheme": "fortunemuse",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/oracle-one-icon.png",
      "bundleIdentifier": "app.fortunemuse",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090B10",
        "foregroundImage": "./assets/images/oracle-one-icon.png",
        "monochromeImage": "./assets/images/oracle-one-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.fortunemuse"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/oracle-one-favicon.png",
      "name": "ORACLE ONE",
      "themeColor": "#15101F",
      "backgroundColor": "#15101F"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15101F",
          "image": "./assets/images/oracle-one-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Fortune Muse uses the microphone so you can speak your question to your fortune spirit.",
          "speechRecognitionPermission": "Fortune Muse turns what you say into text so your fortune spirit can read your question. Audio is not stored."
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false,
          "recordAudioAndroid": false,
          "microphonePermission": "Fortune Muse uses the microphone so you can speak your question to your fortune spirit."
        }
      ]
    ],
    "locales": {
      "zh-Hans": "./locales/zh-Hans.json",
      "zh-Hant": "./locales/zh-Hant.json"
    },
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "description": "I Ching readings for love and money. An open question, a different perspective. For adults 18+."
  }
}
